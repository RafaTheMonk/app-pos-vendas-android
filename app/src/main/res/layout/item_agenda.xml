<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da Agenda. IDs: tvAgCliente, tvAgVeiculo, tvAgDescricao,
     tvAgDataDiagnostico, btnAgendar. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAgCliente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Nome do cliente" />

        <TextView
            android:id="@+id/tvAgVeiculo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            tools:text="Modelo - ABC-1234" />

        <TextView
            android:id="@+id/tvAgDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            tools:text="Descrição do problema." />

        <!-- Aparece só quando já está agendada (mostra a data). -->
        <TextView
            android:id="@+id/tvAgDataDiagnostico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/status_agendada"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Diagnóstico marcado: 12/06/2026"
            tools:visibility="visible" />

        <!-- Aparece só quando está aberta (permite agendar). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/agenda_agendar"
            app:icon="@drawable/ic_agenda"
            app:iconGravity="textStart" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
