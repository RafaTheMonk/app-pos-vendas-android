<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da lista de ocorrências. IDs: tvOcVeiculo, tvOcCliente,
     tvOcDescricao, tvOcData, tvOcStatus, btnExcluirOcorrencia. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOcVeiculo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Modelo - ABC-1234" />

            <TextView
                android:id="@+id/tvOcCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="Cliente: Fulano" />

            <TextView
                android:id="@+id/tvOcDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="Descrição do problema relatado pelo cliente." />

            <TextView
                android:id="@+id/tvOcData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                tools:text="Registrada em 09/06/2026" />

            <TextView
                android:id="@+id/tvOcStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="ABERTA"
                tools:textColor="@color/status_aberta" />

            <TextView
                android:id="@+id/tvOcValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                tools:text="Diagnóstico: R$ 150,00" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnExcluirOcorrencia"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/acao_excluir"
            android:src="@drawable/ic_delete" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
