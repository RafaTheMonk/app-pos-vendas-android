<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da lista de veículos. IDs: ivMiniatura, tvModeloPlaca, tvPlacaItem,
     tvDono, btnExcluirVeiculo. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Miniatura da foto carregada do caminho salvo no banco. -->
        <ImageView
            android:id="@+id/ivMiniatura"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="14dp"
            android:background="@color/fundo_tela"
            android:contentDescription="@string/desc_foto_veiculo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_veiculo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvModeloPlaca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Modelo (2020)" />

            <TextView
                android:id="@+id/tvPlacaItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="Placa: ABC-1234" />

            <TextView
                android:id="@+id/tvDono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="Dono: Fulano" />

            <TextView
                android:id="@+id/tvVeiculoCobranca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Fora da garantia · R$ 300,00"
                tools:textColor="@color/status_aberta" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnExcluirVeiculo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/acao_excluir"
            android:src="@drawable/ic_delete" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
